# BrightWire Environment Variables
# Copy this to .env and fill in your values

# ===========================================
# REQUIRED
# ===========================================

# MongoDB connection string
# Get one free at https://www.mongodb.com/atlas
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/brightwire

# Anthropic API Key for AI classification & rewriting
# Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# Admin password for /admin dashboard
# Set this to a secure password of your choice
ADMIN_SECRET=your-secure-admin-password

# ===========================================
# INNGEST (Auto-configured via Vercel integration)
# ===========================================

# These are automatically set when you connect Inngest via Vercel Marketplace
# INNGEST_EVENT_KEY=xxx
# INNGEST_SIGNING_KEY=xxx

# ===========================================
# OPTIONAL
# ===========================================

# Mailerlite Newsletter Integration
# Get these from https://dashboard.mailerlite.com
# 1. API Key: Integrations → API → Generate new token
# 2. Group ID: Subscribers → Groups → Click group → ID is in URL
MAILERLITE_API_KEY=eyJ0eXAiOiJKV1Qi...
MAILERLITE_GROUP_ID=123456789

# ===========================================
# RESEND - Contact Form Emails
# ===========================================

# Get from https://resend.com/api-keys
# Make sure to verify your domain first!
RESEND_API_KEY=re_xxxxxxxx

# ===========================================
# EMAILABLE - Email Verification
# ===========================================

# Get from https://app.emailable.com/api
# Used to verify email addresses before subscribing
EMAILABLE_API_KEY=your_emailable_api_key

# ===========================================
# FORMS (Formspree - No env vars needed)
# ===========================================
# Create forms at https://formspree.io (free: 50 submissions/month)
# Then replace YOUR_FORM_ID in:
#   - pages/contact.vue
#   - pages/submit.vue
# with your actual Formspree form ID (e.g., xyzabcde)

# Cloudinary cloud name for image proxying
# Get free at https://cloudinary.com/
# Default "demo" works but has limits
CLOUDINARY_CLOUD_NAME=your-cloud-name

# Maximum age of articles to fetch (in hours)
# Default is 168 (7 days). Set lower for fresher news.
NEWS_MAX_AGE_HOURS=168

# Your production URL (for SEO, sharing)
# IMPORTANT: Also set this in Admin Dashboard > Settings > Site URL
SITE_URL=https://brightwire.news

# ===========================================
# ANALYTICS & COOKIES (Configure in nuxt.config.ts)
# ===========================================

# Google Analytics (GA4)
# 1. Go to https://analytics.google.com
# 2. Create property → Get Measurement ID (G-XXXXXXXXXX)
# 3. Replace YOUR_GA_ID in nuxt.config.ts with your ID

# CookieYes - Cookie Consent Banner
# 1. Go to https://www.cookieyes.com → Create free account
# 2. Add your domain → Get your Client ID
# 3. Replace YOUR_COOKIEYES_ID in nuxt.config.ts with your ID
# 4. In CookieYes dashboard: categorize Google Analytics as "Analytics"

# ===========================================
# GOOGLE AD MANAGER (Optional)
# ===========================================

# Google Ad Manager Network Code
# 1. Go to https://admanager.google.com
# 2. Sign up for Google Ad Manager (free for <90M impressions/month)
# 3. Go to Admin > Global Settings > Network code
# 4. Copy your network code (e.g., 12345678)
# Leave empty to use only self-managed ads
GAM_NETWORK_CODE=

# ===========================================
# PUSHER - Real-time Updates (Optional)
# ===========================================

# Pusher enables instant "new stories available" notifications
# Without it, the site falls back to polling every 2 minutes
#
# 1. Go to https://pusher.com → Sign up (free tier: 200K messages/month)
# 2. Create a new "Channels" app
# 3. Go to App Keys and copy these values:

PUSHER_APP_ID=
PUSHER_KEY=
PUSHER_SECRET=
PUSHER_CLUSTER=us2

# ===========================================
# AYRSHARE - Social Media Posting (Optional)
# ===========================================

# Ayrshare enables automatic posting to social media platforms
# 1. Go to https://ayrshare.com → Sign up (starts at $29/month)
# 2. Connect your social accounts (Twitter, Facebook, Instagram, LinkedIn, etc.)
# 3. Go to API Keys → Copy your API key

AYRSHARE_API_KEY=

# ===========================================
# HEYGEN - AI Video Generation (Optional)
# ===========================================

# HeyGen creates AI avatar videos from text
# 1. Go to https://heygen.com → Sign up
# 2. Go to Settings → API → Copy your API key
# 3. Avatars are selected in the UI - no env var needed!

HEYGEN_API_KEY=
